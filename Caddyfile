{$DOMAIN} {
	# Bewusst grösser als das Multer-Limit (512MB) im Server: so lehnt
	# Multer zu grosse Dateien sauber mit 413 ab, statt dass Caddy den
	# Stream mittendrin kappt (das erzeugt "Unexpected end of form").
	request_body {
		max_size 600MB
	}

	# flush_interval -1: Server-Sent Events sofort durchreichen,
	# nicht puffern.
	reverse_proxy app:3000 {
		flush_interval -1
	}
}
